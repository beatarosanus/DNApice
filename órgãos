class SistemaExcretor:
    def __init__(self):
        self.capacidade_Maxima_Urina = 500

    def esta_cheia(self):
        return self.capacidade_Maxima_Urina <= 0


class Rins:
    def __init__(self):
        self.filtracao = True

    def filtrarSangue(self, corpo):
        if corpo.hidratacao > 0:
            corpo.hidratacao -= 1
            return True
        return False


class Pulmao:
    def __init__(self):
        self.estaSaudavel = True

    def oxigenacao(self, corpoHumano):
        corpoHumano.saturacao_oxigenio += 1

    def verificarNivelOxigenio(self, corpo):
        return corpo.saturacao_oxigenio >= 95
